{
	"name": "Java Swing (GUI) Dev Container",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},
	"remoteEnv": {
		"DISPLAY": ":1"
	},
	"forwardPorts": [5901, 6080],
	"portsAttributes": {
		"5901": {
			"label": "VNC Server",
			"onAutoForward": "silent"
		},
		"6080": {
			"label": "noVNC (Browser GUI)",
			"onAutoForward": "openBrowser"
		}
	},
	"postStartCommand": "bash /usr/local/bin/start-vnc.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"vscjava.vscode-java-pack",
				"ms-vscode.copilot-mermaid-diagram"
			],
			"settings": {
				"java.configuration.updateBuildConfiguration": "automatic"
			}
		}
	}
}
